---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import VideoPlayer from '../../components/VideoPlayer.astro';
import PromptBlock from '../../components/PromptBlock.astro';

export async function getStaticPaths() {
  const works = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
  return works.map((work, i) => ({
    params: { slug: work.id },
    props: { work, next: works[(i + 1) % works.length] },
  }));
}

interface Props {
  work: CollectionEntry<'work'>;
  next: CollectionEntry<'work'>;
}

const { work, next } = Astro.props;
const d = work.data;
const { Content } = await render(work);
const hasBody = Boolean(work.body?.trim());
---

<Base title={d.title} description={d.summary} image={d.cover}>
  <section class="case-hero container">
    <p class="eyebrow"><a href="/work">← Work</a> &nbsp;/&nbsp; {d.category}{d.demo && ' · Demo'}</p>
    <h1 class="case-hero__title" style="margin-top:20px">{d.title}</h1>
    <p class="case-hero__summary">{d.summary}</p>

    <dl class="facts">
      <div><dt class="eyebrow">Role</dt><dd>{d.role}</dd></div>
      <div><dt class="eyebrow">Year</dt><dd>{d.year}</dd></div>
      {d.client && <div><dt class="eyebrow">Client</dt><dd>{d.client}</dd></div>}
      {d.tools.length > 0 && <div><dt class="eyebrow">Tools</dt><dd>{d.tools.join(', ')}</dd></div>}
    </dl>

    {d.video ? (
      <VideoPlayer
        src={d.video.src}
        poster={d.video.poster ?? d.cover}
        aspect={d.video.aspect}
        title={d.title}
        transitionName={`media-${work.id}`}
      />
    ) : (
      <div class="player" style={`view-transition-name: media-${work.id}`}>
        <img src={d.cover} alt={d.title} width="1600" height="900" />
      </div>
    )}

    {d.results.length > 0 && (
      <div class="results">
        {d.results.map((r) => <div class="reveal"><strong>{r.value}</strong><span>{r.label}</span></div>)}
      </div>
    )}
  </section>

  {(hasBody || d.prompt) && (
    <section class="section">
      <div class="container case-grid">
        <div class="prose">
          {hasBody ? <Content /> : <p>{d.summary}</p>}
          {d.links.length > 0 && (
            <p style="display:flex;flex-wrap:wrap;gap:12px;margin-top:32px">
              {d.links.map((l) => (
                <a class="btn" href={l.url} target="_blank" rel="noopener" style="color:inherit;text-decoration:none">
                  {l.label} <span class="arrow">↗</span>
                </a>
              ))}
            </p>
          )}
        </div>
        {d.prompt && (
          <div class="sticky">
            <PromptBlock prompt={d.prompt} label="Key prompt" negativePrompt={d.negativePrompt} params={d.params} />
          </div>
        )}
      </div>
    </section>
  )}

  {d.pipeline.length > 0 && (
    <section class="section" style="padding-top:0">
      <div class="container">
        <p class="eyebrow reveal" style="margin-bottom:20px">Pipeline</p>
        <ol class="pipeline" style="list-style:none;margin:0;padding:0">
          {d.pipeline.map((p, i) => (
            <li class="pipeline__step reveal">
              <span class="step__num">0{i + 1}</span>
              <b>{p.tool}</b>
              <small>{p.step}</small>
            </li>
          ))}
        </ol>
      </div>
    </section>
  )}

  {d.iterations.length > 0 && (
    <section class="section" style="padding-top:0">
      <div class="container">
        <p class="eyebrow reveal" style="margin-bottom:20px">Iterations</p>
        <div class="iterations">
          {d.iterations.map((it) => (
            <article class="iteration reveal">
              {it.image && <img src={it.image} alt={`${d.title} — ${it.label}`} loading="lazy" width="800" height="500" />}
              <div>
                <span class="step__num">{it.label}</span>
                <p>{it.note}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  {d.gallery.length > 0 && (
    <section class="section" style="padding-top:0">
      <div class="container gallery">
        {d.gallery.map((g) => <img class="reveal" src={g.src} alt={g.alt} loading="lazy" />)}
      </div>
    </section>
  )}

  {next.id !== work.id && (
    <a class="next" href={`/work/${next.id}`}>
      <div class="container">
        <p class="eyebrow">Next project</p>
        <h2 class="next__title">{next.data.title} →</h2>
      </div>
    </a>
  )}
</Base>
